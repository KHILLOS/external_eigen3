package {
    default_applicable_licenses: ["external_eigen3_license"],
}

license {
    name: "external_eigen3_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-MPL-2.0",
        "SPDX-license-identifier-Apache-2.0",
        "SPDX-license-identifier-BSD-3-Clause",
    ],
    license_text: ["COPYING.MPL2", "COPYING.APACHE", "COPYING.BSD", "COPYING.MINPACK"],
}

license {
    name: "external_eigen3_bench_license",
    visibility: ["//visibility:private"],
    license_kinds: ["SPDX-license-identifier-GPL-2.0-or-later"],
    license_text: ["COPYING.GPL"],
}

license {
    name: "external_eigen3_restricted_code_license",
    visibility: ["//visibility:private"],
    license_kinds: ["SPDX-license-identifier-LGPL-2.1-only"],
    license_text: ["COPYING.LGPL"],
}

filegroup {
    name: "eigen3_bench_srcs",
    visibility: ["//visibility:private"],
    licenses: ["external_eigen3_bench_license"],
    srcs: ["bench/**"],
}

filegroup {
    name: "eigen3_restricted_code_srcs",
    visibility: ["//visibility:private"],
    licenses: ["external_eigen3_restricted_code_license"],
    srcs: [
        "unsupported/Eigen/src/IterativeSolvers/ConstrainedConjGrad.h",
        "unsupported/Eigen/src/IterativeSolvers/IterationController.h",
    ],
}

cc_library_headers {
    name: "libeigen3",
    export_include_dirs: ["."],
    vendor_available: true,
    host_supported: true,
    product_available: true,
    ramdisk_available: true,
    vendor_ramdisk_available: true,
    recovery_available: true,
    native_bridge_supported: true,
    target: {
        linux_bionic: {
            enabled: true,
        },
        windows: {
            enabled: true,
        },
    },
    min_sdk_version: "29",
    sdk_version: "current",
    apex_available: [
        "//apex_available:anyapex",
        "//apex_available:platform",
        "com.android.neuralnetworks",
        "test_com.android.neuralnetworks",
    ],
    cflags: ["-DEIGEN_MPL2_ONLY"],
    visibility: ["//system/libbase"],
}

// Compatibility twin of libeigen3 under the module name that pristine AOSP
// external/eigen used ("libeigen"). Pristine-tree consumers such as
// external/tensorflow (tensorflow/lite/kernels/Android.bp) depend on
// "libeigen"; khillos.xml replaces platform/external/eigen with this repo,
// so the name must resolve. Content and export paths are identical to
// libeigen3. Upstream AOSP is dropping the duplicate consumers over time
// (their eigen commit f8c9a7b46 adds include-path compat symlinks for the
// same reason) — remove this twin when the tree no longer needs it.
cc_library_headers {
    name: "libeigen",
    export_include_dirs: ["."],
    cflags: ["-DEIGEN_MPL2_ONLY"],
    vendor_available: true,
    host_supported: true,
    apex_available: [
        "com.android.neuralnetworks",
        "//apex_available:platform",
        "com.android.ondevicepersonalization",
        "com.android.appsearch",
    ],
    min_sdk_version: "apex_inherit",
    sdk_version: "current",
    visibility: ["//visibility:public"],
}

cc_library_static {
    name: "libF77blas-eigen3",
    srcs: ["blas/*.c", "blas/f2c/*.c"],
    export_include_dirs: ["."],
    vendor_available: true,
    host_supported: true,
    product_available: true,
    ramdisk_available: true,
    vendor_ramdisk_available: true,
    recovery_available: true,
    native_bridge_supported: true,
    target: {
        linux_bionic: {
            enabled: true,
        },
        windows: {
            enabled: true,
        },
    },
    min_sdk_version: "29",
    sdk_version: "current",
    apex_available: [
        "//apex_available:anyapex",
        "//apex_available:platform",
        "com.android.neuralnetworks",
    ],
    visibility: ["//system/libbase"],
}

cc_library_static {
    name: "libF77blasV8-eigen3",
    srcs: ["blas/*.c", "blas/f2c/*.c"],
    export_include_dirs: ["."],
    vendor_available: true,
    host_supported: true,
    product_available: true,
    ramdisk_available: true,
    vendor_ramdisk_available: true,
    recovery_available: true,
    native_bridge_supported: true,
    target: {
        linux_bionic: {
            enabled: true,
        },
        windows: {
            enabled: true,
        },
    },
    min_sdk_version: "9",
    sdk_version: "9",
    apex_available: [
        "//apex_available:anyapex",
        "//apex_available:platform",
    ],
    visibility: ["//system/libbase"],
}

// Compatibility twins for the module names that pristine AOSP
// external/eigen's blas/Android.bp provides (libF77blas, libF77blasV8)
// and external/cblas depends on. khillos.xml replaces platform/external/eigen
// with this repo, so those names must resolve here. Source set matches the
// pristine eigen-defaults (the .c sources live under blas/f2c; top-level
// BLAS drivers are .cpp — the -eigen3 variants' "blas/*.c" glob matches
// nothing and those modules stay unused).
cc_defaults {
    name: "eigen_f77_compat_defaults",
    srcs: [
        "blas/single.cpp",
        "blas/double.cpp",
        "blas/complex_single.cpp",
        "blas/complex_double.cpp",
        "blas/xerbla.cpp",
        "blas/f2c/complexdots.c",
        "blas/f2c/srotm.c",
        "blas/f2c/srotmg.c",
        "blas/f2c/drotm.c",
        "blas/f2c/drotmg.c",
        "blas/f2c/lsame.c",
        "blas/f2c/dspmv.c",
        "blas/f2c/ssbmv.c",
        "blas/f2c/chbmv.c",
        "blas/f2c/sspmv.c",
        "blas/f2c/zhbmv.c",
        "blas/f2c/chpmv.c",
        "blas/f2c/dsbmv.c",
        "blas/f2c/zhbmv.c",
        "blas/f2c/dtbmv.c",
        "blas/f2c/stbmv.c",
        "blas/f2c/ctbmv.c",
        "blas/f2c/ztbmv.c",
        "blas/f2c/d_cnjg.c",
        "blas/f2c/r_cnjg.c",
    ],
    cflags: [
        "-Werror",
        "-Wno-unused-parameter",
    ],
    export_include_dirs: ["."],
}

cc_library_static {
    name: "libF77blas",
    vendor_available: true,
    defaults: ["eigen_f77_compat_defaults"],
    host_supported: true,
    native_bridge_supported: true, // TODO(b/153609531): remove when no longer needed.
}

// Build Eigen using API 9 toolchain for RS Support lib.
cc_library_static {
    name: "libF77blasV8",
    defaults: ["eigen_f77_compat_defaults"],
    sdk_version: "9",
    stl: "c++_static",
}